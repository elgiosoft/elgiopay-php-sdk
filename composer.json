{
    "name": "elgiosoft/elgiopay-php-sdk",
    "description": "PHP SDK for ElgioPay Service - Mobile Money payments for Cameroon and West Africa",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Elgiosoft Ltd",
            "email": "developers@elgiosoft.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "ElgioPay\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElgioPay\\SDK\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "payment",
        "mobile-money",
        "mtn",
        "orange-money",
        "cameroon",
        "xaf",
        "west-africa",
        "fintech",
        "api",
        "sdk"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
